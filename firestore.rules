rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Task
    function isValidTask(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'date',
          'startTime',
          'isAllDay',
          'durationMinutes',
          'color',
          'icon',
          'recurrence',
          'completed',
          'completedDates',
          'subtasks',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'date',
          'startTime',
          'isAllDay',
          'durationMinutes',
          'color',
          'icon',
          'recurrence',
          'completed',
          'completedDates',
          'subtasks',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.date is string
        && data.date.size() <= 10
        && data.date.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && data.startTime is string
        && data.startTime.size() <= 5
        && data.startTime.matches('^([0-2][0-9]:[0-5][0-9])?$')
        && data.isAllDay is bool
        && data.durationMinutes is int
        && data.durationMinutes >= 1
        && data.durationMinutes <= 720
        && data.color is string
        && data.color.size() >= 1
        && data.color.size() <= 16
        && data.color in ['coral', 'sage', 'slate', 'amber', 'lavender', 'teal']
        && data.icon is string
        && data.icon.size() >= 1
        && data.icon.size() <= 20
        && data.icon in ['book', 'alarm', 'yoga', 'bike', 'users', 'laundry', 'phone', 'run', 'plant', 'sparkles', 'coffee', 'code', 'briefcase', 'heart', 'music', 'utensils']
        && data.recurrence is string
        && data.recurrence.size() >= 1
        && data.recurrence.size() <= 16
        && data.recurrence in ['none', 'daily', 'weekdays', 'weekly']
        && data.completed is bool
        && data.completedDates is list
        && data.completedDates.size() <= 366
        && (data.completedDates.size() == 0 || (data.completedDates[0] is string && data.completedDates[0].size() == 10))
        && data.subtasks is list
        && data.subtasks.size() <= 20
        && (data.subtasks.size() == 0 || (data.subtasks[0] is string && data.subtasks[0].size() >= 2 && data.subtasks[0].size() <= 200))
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPreference
    function isValidUserPreference(data) {
      return data.keys().hasAll(['ownerId', 'theme', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'theme', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.theme is string
        && data.theme.size() >= 4
        && data.theme.size() <= 5
        && data.theme in ['light', 'dark']
        && data.updatedAt is timestamp;
    }

    // Collection: /tasks/{taskId}
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(taskId)
        && isValidTask(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Toggle completion or subtasks
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'completedDates', 'subtasks', 'updatedAt']) ||
          // Action 2: Full task edit or scheduling from inbox
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'date',
            'startTime',
            'isAllDay',
            'durationMinutes',
            'color',
            'icon',
            'recurrence',
            'completed',
            'completedDates',
            'subtasks',
            'notes',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(taskId)
        && existing().ownerId == request.auth.uid;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPreference(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPreference(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt']);

      allow delete: if false;
    }
  }
}
